				{
					"name": "1. Create Booking",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// to create an environment variable for the booking id\r",
									"var jsonData = pm.response.json();  //convert response body to json object\r",
									"pm.environment.set(\"act_b_Id\", jsonData.bookingid); //assign the booking id to the environment variable\r",
									"\r",
									"pm.test(\"Verify status code is 200\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"/*\r",
									"pm.test(\"Verify first name string\", function () {\r",
									"    var jsonData = pm.response.json();\r",
									"    pm.expect(jsonData.booking.firstname).to.eql(pm.environment.get(\"fname\"));\r",
									"\r",
									"});\r",
									"\r",
									"pm.test(\"Verify first name string\", function () {\r",
									"    var expectedFirstName;\r",
									"    if (typeof pm.iterationData !== 'undefined' && pm.iterationData.fname) {\r",
									"        expectedFirstName = pm.iterationData.fname;\r",
									"    } else {\r",
									"        expectedFirstName = pm.environment.get(\"fname\");\r",
									"    }\r",
									"    pm.expect(jsonData.booking.firstname).to.eql(expectedFirstName);\r",
									"});\r",
									"\r",
									"pm.test(\"Verify first name body matches string\", function () {\r",
									"    pm.expect(pm.response.text()).to.include(\"Cooke\");\r",
									"});\r",
									"*/\r",
									"pm.test(\"Verify Content-Type is present\", function () {\r",
									"    pm.response.to.have.header(\"Content-Type\", \"application/json; charset=utf-8\");\r",
									"});\r",
									"\r",
									"pm.test(\"Response time is less than 2000ms\", function () {\r",
									"    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
									"});\r",
									"\r",
									"var vfname = pm.variables.get(\"fname\");\r",
									"var vlname = pm.variables.get(\"lname\");\r",
									"pm.environment.set(\"vfname\", jsonData.booking.firstname);\r",
									"pm.test(\"Verify first name\", function () {\r",
									"    pm.expect(jsonData.booking.firstname).to.eql(vfname);\r",
									"});\r",
									"\r",
									"pm.test(\"Verify last name\", function () {\r",
									"    pm.expect(jsonData.booking.lastname).to.eql(vlname);\r",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
