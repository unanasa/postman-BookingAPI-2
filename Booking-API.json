							"mode": "raw",
							"raw": "{\r\n    \"firstname\": \"{{fname}}\",\r\n    \"lastname\": \"{{lname}}\",\r\n    \"totalprice\": 1500,\r\n    \"depositpaid\": true,\r\n    \"bookingdates\": {\r\n        \"checkin\": \"2025-05-01\",\r\n        \"checkout\": \"2025-12-30\"\r\n    },\r\n    \"additionalneeds\": \"Dinner\"\r\n}",
